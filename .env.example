# =============================================================================
# PM Structure: single local env file (repo root .env.local)
# Copy:  cp .env.example .env.local
# Link:  npm run env:link   (symlinks all apps to this file)
# Production: set vars per Vercel project: docs/DEPLOYMENT_VERCEL.md
# =============================================================================

# ─── Public URLs (local dev gateway → http://localhost:3000) ───
# Production (Vercel marketing project): NEXT_PUBLIC_SITE_URL=https://pmstructure.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Lead recovery popups + bottom bar (default: enabled). Set to false to disable.
NEXT_PUBLIC_LEAD_RECOVERY_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=/admin

# Auth email links (password reset). Defaults to NEXT_PUBLIC_SITE_URL if unset.
# Set to production URL when running `npm run dev` locally but sending real emails:
# AUTH_EMAIL_SITE_URL=https://pmstructure.com

# Internal server ports (gateway proxies: do not open in browser)
BACKEND_URL=http://localhost:3001
DASHBOARD_BACKEND_URL=http://localhost:3002

# Production marketing project (Vercel): leave BACKEND_URL unset — /api/* is bundled at build.
# Split deploy only:
# BACKEND_URL=https://your-backend.vercel.app
# USE_BACKEND_PROXY=true

# ─── Supabase (Settings → API) ───
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres for npm run db:migrate (Settings → Database → connection string)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
# SUPABASE_DB_PASSWORD=your_database_password

# ─── Dashboard auth (dashboard_one: docs/auth/AUTH_SYSTEM.md) ───
NEXT_PUBLIC_AUTH_USE_API_LOGIN=true
# AUTH_SESSION_SECRET=                          # openssl rand -base64 32
# AUTH_BOOTSTRAP_SECRET=                        # openssl rand -base64 32
# DASHBOARD_ADMIN_EMAILS=nauticalinsights.ai@gmail.com
# AUTH_ALLOWED_ORIGINS=https://pmstructure.com
# AUTH_DEV_LOG_RESET_LINK=true
# AUTH_DEV_LOG_OTP=true

# ─── Email (SMTP — OTP, password reset, order confirmations) ───
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-gmail-app-password
# AUTH_EMAIL_FROM=you@gmail.com
# AUTH_EMAIL_FROM_NAME=PM Structure
# ORDER_EMAIL_FROM=orders@pmstructure.com
# ORDER_EMAIL_FROM_NAME=PM Structure
# ORDER_ONBOARDING_CALENDLY_URL=https://calendly.com/pm-structure/go-talk-to-mentor
# NEXT_PUBLIC_ONBOARDING_CALENDLY_URL=https://calendly.com/pm-structure/go-talk-to-mentor

# ─── Stripe (embedded seat deposit checkout on enrollment page) ───
# Required on the marketing frontend Vercel project (and repo root .env.local for dev):
# STRIPE_SECRET_KEY=sk_test_...                    # creates checkout sessions (bundled /api/checkout)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   # embedded checkout UI (also baked into client bundle)
# STRIPE_PUBLISHABLE_KEY=pk_test_...               # optional server-only fallback if NEXT_PUBLIC_* unset at build
# STRIPE_WEBHOOK_SECRET=whsec_...                  # /api/stripe/webhook → marks orders paid

# ─── Twilio (SMS OTP on new device — docs/auth/AUTH_SYSTEM.md) ───
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=

# ─── Interactions admin pings (docs/interactions/INTERACTIONS_SETUP.md) ───
# INTERACTIONS_ADMIN_EMAIL=admin@example.com
# DISCOVERY_CALL_ADMIN_EMAIL=

# ─── Google Sheets (interactions pipeline — docs/interactions/INTERACTIONS_SETUP.md) ───
# Google Sheet title: "PMS structure Website" (create in Drive, share with service account)
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON_BASE64=
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_RANGE=Submissions!A:G
# INTERACTIONS_ADMIN_EMAIL=nauticalinsights.ai@gmail.com
# GOOGLE_SHEETS_EDITOR_URL=
# INTERACTIONS_REALTIME_CHANNEL=
# NEXT_PUBLIC_INTERACTIONS_REALTIME_CHANNEL=

# ─── SEO / IndexNow (optional) ───
# INDEXNOW_KEY=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Support chat (AI widget — docs/SUPPORT_CHATBOT.md) ───
# NEXT_PUBLIC_SUPPORT_CHAT_ENABLED=true
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-v1-...
# CHROMA_HOST=api.trychroma.com
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=websitebot
# CHROMA_SUPPORT_COLLECTION=pms_support

# ─── Optional ───
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/447947540939
# NEXT_PUBLIC_WHATSAPP_DISPLAY=+44 7947 540939
# NEXT_PUBLIC_WHATSAPP_GREETING=Hi PM Structure — I'd like help planning my certification pathway.
# NEXT_PUBLIC_SKOOL_COMMUNITY_JOIN_URL=https://pmstructure.com/join?invitation_token=...
# Calendly: “Talk to Mentor” popup (navbar, hero, FAQ, bottom bar)
# NEXT_PUBLIC_TALK_TO_MENTOR_CALENDLY_URL=https://calendly.com/pm-structure/talk-to-mentor
# Calendly: PM advisory /pm-service (“Talk to Advisor”, service cards, final CTA)
# NEXT_PUBLIC_TALK_TO_ADVISOR_CALENDLY_URL=https://calendly.com/pm-structure/talk-to-advisor
# Legacy alias: NEXT_PUBLIC_CALENDLY_EVENT_URL_WEBSITE_HERO (mentor URL if unset above)
# Per-slug overrides: NEXT_PUBLIC_CALENDLY_EVENT_{SLUG_TOKEN} (see docs/CALENDLY_CHANNEL_EVENTS.md)
# Example: NEXT_PUBLIC_CALENDLY_EVENT_SYNDICATED_DISCOVERY=https://calendly.com/booking-sh3ikhmabz/go-syndicated-discovery
# Calendly API: provision event types (scripts/provision-calendly-*.mjs only; never commit)
# CALENDLY_API_TOKEN=
